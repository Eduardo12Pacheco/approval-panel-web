/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# HTML — always revalidate so the shell picks up new module URLs/contracts.
/
  Cache-Control: no-cache, max-age=0, must-revalidate

# Static assets with content-addressed URLs — cache aggressively.
/assets/*.webm
  Cache-Control: public, max-age=31536000, immutable

# JS and CSS — never serve stale app code; this panel has no bundler/content hashes.
/styles/*.css
  Cache-Control: no-cache, max-age=0, must-revalidate

/js/main.js
  Cache-Control: no-cache, max-age=0, must-revalidate

/js/modules/*.js
  Cache-Control: no-cache, max-age=0, must-revalidate

/js/modules/**/*.js
  Cache-Control: no-cache, max-age=0, must-revalidate

/favicon.svg
  Cache-Control: public, max-age=31536000, immutable
